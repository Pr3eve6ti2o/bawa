# Copy to .env and populate with the PUBLIC values generated by:
#   node tools/hdwallet-gen/generate.js
#
# Never put mnemonics, BIP-39 passphrases, seed bytes, xprv/zprv or the AES
# recovery data key in this file. Account xpub/zpub values are non-spending
# public material but are privacy-sensitive because they reveal the address
# derivation graph below the exported account node.

XPUB_BTC=
XPUB_ETH=
XPUB_TRX=
TON_DEPOSIT_ADDRESS=

# Optional overrides (only these are read by the code on this branch):
# NOVA_SECRETS_DIR=/absolute/path/to/secrets
# NOVA_ENV=/absolute/path/to/.env
# BAWA_DATA_KEY is read from the environment by tools/decrypt_seed.py, never from this file.
