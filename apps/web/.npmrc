# OI-095: enforce the declared Node engines range (>=22 <23).
# Without this, npm only warns (EBADENGINE) and installs anyway.
engine-strict=true
# T48 F-04: never run install lifecycle scripts (a compromised
# dependency update could execute code at install time). Verified
# benign here: the only install script in the tree is protobufjs
# postinstall, which returns early unless the consumer sets
# versionScheme. `npm run` scripts are unaffected.
ignore-scripts=true
