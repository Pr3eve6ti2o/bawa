    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@scure/bip39": "2.4.0",
    "@trustwallet/wallet-core": "4.9.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "decimal.js": "10.6.0",
    "dinero.js": "2.0.2",
    "jsqr": "1.4.0",
    "long": "5.3.2",
    "lucide-react": "1.14.0",
    "qrcode.react": "4.2.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-router": "7.18.5",
    "sonner": "2.0.7",
    "tailwind-merge": "3.5.0",
    "tailwindcss": "4.2.4",
    "tw-animate-css": "1.4.0",
    "viem": "2.58.0"
