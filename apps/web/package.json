{
  "name": "@bawa/web",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-wasm.mjs && vite",
    "build": "node scripts/copy-wasm.mjs && tsc --noEmit && vite build && npm run palette-audit",
    "build:e2e": "node scripts/copy-wasm.mjs && tsc --noEmit && vite build --base / && npm run palette-audit",
    "palette-audit": "node scripts/palette-audit.mjs",
    "preview": "vite preview",
    "preview:e2e": "vite preview --base /",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint src scripts vite.config.ts vitest.config.ts",
    "clean": "rm -rf dist",
    "predev": "node scripts/copy-wasm.mjs",
    "prebuild": "node scripts/copy-wasm.mjs"
  },
  "dependencies": {
    "@bawa/contracts": "file:../../packages/contracts",
    "@fontsource-variable/baloo-2": "5.3.0",
    "@fontsource-variable/noto-sans": "5.2.10",
