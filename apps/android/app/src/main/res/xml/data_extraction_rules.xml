<?xml version="1.0" encoding="utf-8"?>
<!-- T49 F-03: backup / device-transfer opt-out for the generated Android
     wallet. allowBackup="false" is the primary switch; the rules below
     are belt-and-braces for API 31+ transports that honour extraction
     rules (including OEM device-to-device transfer) and exclude every
     storage domain in both sections. No wallet data may leave the
     device through system backup or transfer.
     Both sections need ALL NINE domains (C5 re-audit, confirmed against
     AOSP BackupAgent path matching and published nine-domain guidance):
     exclusions do NOT inherit across sections, and excluding `root`
     alone does not cover `file`/`database`/`sharedpref` — each domain
     is traversed from its own root. The `device_*` entries cover
     device-protected storage areas, which are storage areas, not
     transports; the ordinary five cover credential-encrypted storage.
     An empty <device-transfer> would mean "transfer everything". -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
