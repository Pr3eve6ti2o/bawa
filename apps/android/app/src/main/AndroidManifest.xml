<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Step 3 data layer: INTERNET is declared for the Step 5 network
         stack (live prices, balances, history). The app makes no
         network calls yet — the data layer loads the bundled registry
         export from assets only. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Step 5, Lane C: CAMERA for the QR / barcode scanner
         (ui/scanner/QrCodeScanner.kt). The scanner only reads an
         address / QR text and returns it to the caller; it never
         sends anything. uses-feature required=false so devices
         without a camera can still install. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- T47: allowBackup="false" — this is a wallet. App data (including any
         future persisted watch-only data) must never leave the device in a
         cloud backup or an adb backup. The starter currently keeps xpubs in
         memory only; this closes the backup exfiltration path before any
         persistence is added. networkSecurityConfig states the existing
         posture explicitly: no cleartext traffic (the app makes no network
         calls yet; INTERNET is declared for the Step 5 network stack). -->
    <application
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="Bawa Wallet"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bawa">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
