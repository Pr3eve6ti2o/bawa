<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- T47: allowBackup="false" — this is a wallet. App data (including any
         future persisted watch-only data) must never leave the device in a
         cloud backup or an adb backup. The starter currently keeps xpubs in
         memory only; this closes the backup exfiltration path before any
         persistence is added. networkSecurityConfig states the existing
         posture explicitly: no cleartext traffic (the app makes no network
         calls at all and requests no INTERNET permission). -->
    <application
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="Bawa Wallet"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bawa">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
